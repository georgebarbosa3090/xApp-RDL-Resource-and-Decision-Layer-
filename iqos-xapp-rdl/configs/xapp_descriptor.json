{
  "name": "iqos-xapp-rdl",
  "version": "1.0.0",
  "rxMessages": ["RIC_INDICATION"],
  "txMessages": ["RIC_SUBSCRIPTION_REQUEST", "RIC_CONTROL_REQUEST"],
  "policies": [],
  "rmr": {
    "rxMessages": [12050, 12011, 12012, 30000],
    "txMessages": [12010, 12040],
    "maxSize": 2072,
    "numWorkers": 1
  },
  "containers": [
    {
      "name": "iqos-xapp-rdl",
      "image": {
        "registry": "docker.io",
        "name": "iqos-xapp-rdl",
        "tag": "latest"
      },
      "env": [
        { "name": "RIC_HOST", "value": "service-ricplt-e2term-sctp" },
        { "name": "RMR_SEED_RT", "value": "/app/configs/uta_rtg.rt" }
      ],
      "resources": {
        "limits": { "memory": "512Mi", "cpu": "1000m" }
      }
    }
  ],
  "livenessProbe": {
    "httpGet": { "path": "/health", "port": 8080 }
  }
}
