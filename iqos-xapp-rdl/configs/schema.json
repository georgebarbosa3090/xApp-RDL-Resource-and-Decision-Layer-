{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "xapp_name": { "type": "string" },
    "version": { "type": "string" },
    "vendor": { "type": "string" },
    "containers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "image": {
            "type": "object",
            "properties": {
              "registry": { "type": "string" },
              "name": { "type": "string" },
              "tag": { "type": "string" }
            },
            "required": ["name", "tag"]
          },
          "command": { "type": "array" },
          "resources": { "type": "object" }
        },
        "required": ["name", "image"]
      }
    },
    "messaging": { "type": "object" },
    "rmr": {
      "type": "object",
      "properties": {
        "protPort": { "type": "string" },
        "maxSize": { "type": "integer" },
        "numWorkers": { "type": "integer" },
        "txMessages": { "type": "array" },
        "rxMessages": { "type": "array" }
      },
      "required": ["protPort", "maxSize", "rxMessages"]
    }
  },
  "required": ["xapp_name", "version", "containers", "messaging", "rmr"]
}
